{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Markets window may do: fetch prices from these sources only, store its data in its own folder, show notifications and open links in your browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://query1.finance.yahoo.com/*" },
        { "url": "https://query2.finance.yahoo.com/*" },
        { "url": "https://api.coingecko.com/*" },
        { "url": "https://api.frankfurter.dev/*" },
        { "url": "https://data.alpaca.markets/*" },
        { "url": "https://eodhd.com/*" },
        { "url": "https://login.questrade.com/*" },
        { "url": "https://*.iq.questrade.com/*" },
        { "url": "https://www.alphavantage.co/*" }
      ]
    },
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "notification:default",
    "opener:default"
  ]
}

{
  "name": "markets-by-mp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Markets by MP: an investing platform and the Markets API that powers it.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "openapi": "node --experimental-strip-types scripts/export-openapi.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.20",
    "better-auth": "^1.7.25",
    "big.js": "^7.0.1",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/big.js": "^7.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true,
    "workerd@1.20261113.1": true
  }
}
